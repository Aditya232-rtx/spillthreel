# SpillTheReel API — environment variables.
# Copy to .env and fill in real values. NEVER commit the filled .env.
# All variables read by app/settings.py (Pydantic Settings).

# ==============================================================
# Runtime
# ==============================================================
ENVIRONMENT=dev                     # dev | staging | prod
LOG_LEVEL=DEBUG                     # DEBUG | INFO | WARN | ERROR

# ==============================================================
# Supabase (Auth + Postgres + Storage)
# From: Supabase Dashboard → Project Settings → API
# ==============================================================
# Public — ships in the mobile bundle, safe to commit if ever needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SECRET — backend only. Bypasses RLS. Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — backend only. Used for offline JWT signature verification.
SUPABASE_JWT_SECRET=

# ==============================================================
# Supabase Postgres — SQLAlchemy async URLs
# From: Supabase Dashboard → Project Settings → Database → Connection string
# ==============================================================
# Pooler on :6543 — long-lived app connections. Use for the API + workers.
# Format: postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct on :5432 — Alembic migrations only. Poolers don't like DDL.
# Format: postgresql+asyncpg://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL_DIRECT=

DATABASE_ECHO=false                 # true to log every SQL statement (dev only)

# ==============================================================
# Supabase Storage bucket names (created via dashboard)
# ==============================================================
SUPABASE_BUCKET_MEDIA=media         # thumbnails, transient artifacts
SUPABASE_BUCKET_EXPORTS=exports     # GDPR data export dumps (24h TTL)

# ==============================================================
# GCP (Cloud Run + Cloud Tasks + GKE Cobalt)
# ==============================================================
GCP_PROJECT_ID=
GCP_REGION=us-central1

CLOUD_TASKS_QUEUE_INGEST=ingest
CLOUD_TASKS_QUEUE_IMPORT=import
CLOUD_TASKS_QUEUE_ENHANCE=enhance

# Cloud Run worker service URL — Cloud Tasks POSTs here.
# Leave blank in local dev; the in-process dispatcher takes over.
WORKER_BASE_URL=

# ==============================================================
# Extractors
# ==============================================================
# Cobalt (self-hosted on GKE). Local docker-compose runs it on :9000.
COBALT_BASE_URL=http://localhost:9000
COBALT_API_KEY=

# ==============================================================
# LLM providers
# ==============================================================
# Gemini — from ai.google.dev. SECRET.
GEMINI_API_KEY=
GEMINI_MODEL_FLASH_LITE=gemini-2.5-flash-lite
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# Groq — from console.groq.com. SECRET. Used for ≥5 min audio only.
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo

# ==============================================================
# Memory layer — Cognee Cloud
# ==============================================================
COGNEE_API_KEY=
COGNEE_BASE_URL=https://api.cognee.ai

# ==============================================================
# Observability
# ==============================================================
SENTRY_DSN=                         # optional; leave blank to disable Sentry

# ==============================================================
# Cost guards (TRD §14.3)
# ==============================================================
PER_USER_DAILY_GEMINI_BUDGET_USD=0.50
PER_USER_DAILY_GEMINI_HARD_CAP_USD=1.00
