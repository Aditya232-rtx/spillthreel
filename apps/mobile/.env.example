# SpillTheReel mobile — environment variables.
# Copy to .env and fill in real values. NEVER commit the filled .env.
# From: Supabase Dashboard → Project Settings → API.
#
# WARNING: every EXPO_PUBLIC_* value is EMBEDDED in the app bundle at
# build time. That is fine for the URL + publishable key below, but
# NEVER put the Supabase SECRET key or any server key here.

# Base URL — ships in the mobile bundle.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_…) — public by design; RLS gates access.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<rest-of-key>

# Backend API base URL. Local dev default is baked into src/lib/api.ts
# (http://localhost:8000); set this for preview/production EAS builds.
EXPO_PUBLIC_API_URL=https://api-dev.example.com

# Sentry (optional; unset = silently disabled, local dev unaffected).
EXPO_PUBLIC_SENTRY_DSN=
# 0.0 = no performance tracing (default). Set 0.1+ to sample.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0

# PostHog product analytics (optional; unset = silently disabled).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
